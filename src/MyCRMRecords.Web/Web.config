<?xml version="1.0" encoding="utf-8"?>
<!--
  Web.config for the MyCRMRecords IIS application. It holds no secrets, so every deployment installs this file.
  Do not edit it on the server: put server-only settings in a Web.Local.config file next to it, which deployments
  never touch. Its values override the appSettings below; see the README.
-->
<configuration>
  <appSettings file="Web.Local.config">
    <!-- NetBIOS name of the Windows domain; logins are stored as RSP\username, as in ReportGenerator3 and MyAllocation. -->
    <add key="ADDomain" value="RSP" />
    <!-- Active Directory groups allowed to sign in (a;b). Empty = any domain user (MyCRM let every registered user in). -->
    <add key="MyCRMRecords:AllowedGroups" value="" />
    <!-- Administrators: logins (RSP\jsmith) and/or Active Directory groups, separated by ";". Besides them, administrators
         give the Administrator role on users.aspx. Set it in Web.Local.config on the server. -->
    <add key="MyCRMRecords:Admins" value="" />
    <!-- Shows "Add sample data" on the admin page (sample proposal items and a project). Set it to
         false in Web.Local.config on the server. -->
    <add key="MyCRMRecords:DemoTools" value="true" />
    <!-- Folder of the JSON data files (one per table), used until an administrator switches to SQL Server on admin.aspx
         (the choice is kept in App_Data\database-settings.json); "~/" is the application folder. App_Data is never
         served and is kept by deployments, as are App_Data\crm-records-settings.json (connections, the sync, email)
         and App_Data\scheduled-tasks.json. -->
    <add key="MyCRMRecords:DataFolder" value="~/App_Data/data" />
  </appSettings>
  <system.web>
    <compilation debug="false" targetFramework="4.8" />
    <!-- The pages are saved as UTF-8 without a BOM. -->
    <globalization fileEncoding="utf-8" requestEncoding="utf-8" responseEncoding="utf-8" />
    <!-- Excel uploads up to 20 MB, with room for the form around the file (maxRequestLength is in KB). -->
    <httpRuntime targetFramework="4.8" enableVersionHeader="false" maxRequestLength="22528" />
    <customErrors mode="RemoteOnly" />
    <!-- Sign-in form checked against Active Directory, as in ReportGenerator3 and MyAllocation. In IIS: Anonymous
         Authentication = Enabled, Windows Authentication = Disabled. -->
    <authentication mode="Forms">
      <forms loginUrl="~/login.aspx" defaultUrl="~/" name=".MYCRMRECORDSAUTH" timeout="480" slidingExpiration="true" cookieless="UseCookies" />
    </authentication>
    <authorization>
      <deny users="?" />
    </authorization>
  </system.web>
  <!-- Reachable before signing in. api.ashx and file.ashx check the sign-in themselves and answer 401. -->
  <location path="login.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="logout.aspx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="api.ashx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="file.ashx">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
    <!-- The Files page shows a PDF of MyFiles in the page (file.ashx/files/{id}?view=1 in a frame): its own pages may frame it. -->
    <system.webServer>
      <httpProtocol>
        <customHeaders>
          <remove name="X-Frame-Options" />
          <add name="X-Frame-Options" value="SAMEORIGIN" />
        </customHeaders>
      </httpProtocol>
    </system.webServer>
  </location>
  <location path="app.css">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="Content">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <!-- What makes MyCRMRecords installable as an app (common.js, Install app): browsers fetch the manifest and its icons
       without the sign-in cookie, and the offline page and service worker hold no data. -->
  <location path="manifest.json">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="sw.js">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="offline.html">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <location path="pwa">
    <system.web>
      <authorization>
        <allow users="*" />
      </authorization>
    </system.web>
  </location>
  <system.webServer>
    <security>
      <requestFiltering>
        <!-- Requests up to 22 MB (in bytes; IIS's own limit, besides maxRequestLength). -->
        <requestLimits maxAllowedContentLength="23068672" />
      </requestFiltering>
    </security>
    <staticContent>
      <!-- manifest.json: IIS versions before 10 have no type for .json and would not serve it. -->
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>
    <defaultDocument enabled="true">
      <files>
        <remove value="default.aspx" />
        <add value="default.aspx" />
      </files>
    </defaultDocument>
    <httpProtocol>
      <customHeaders>
        <remove name="X-Content-Type-Options" />
        <add name="X-Content-Type-Options" value="nosniff" />
        <remove name="X-Frame-Options" />
        <add name="X-Frame-Options" value="DENY" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>
</configuration>
